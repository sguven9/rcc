  "provenance": {
    "publishedDimensions": {
      "status": "sourced",
      "note": "1080 mm (42.5 in) span, 14.9 oz (422 g) assembled without battery; 3S 1000–2200 mAh, four 9 g servos.",
      "url": "https://www.amainhobbies.com/flite-test-spitfire-speed-build-electric-airplane-kit-flt-1007/p673671"
    },
    "powerPack": {
      "status": "sourced",
      "note": "Flite Test Power Pack C Radial v.2: Radial 2218 1180 KV, 40 A ESC; listing allows 8×6 or 9×4.7 props, this preset uses 9×4.7 on 3S 2200 mAh.",
      "url": "https://www.getfpv.com/planes/flite-test-power-pack-c-radial-v-2.html"
    },
    "geometry": {
      "status": "estimated",
      "note": "Generated by scripts/generate-catalog-aircraft.ts from the sourced span, wing area and length. Rectangular-equivalent panels use the 0.185 m mean chord; fuselage sections, wing position, incidence 1.5° and dihedral are estimates, not traced plans."
    },
    "tail": {
      "status": "calculated",
      "note": "Tail areas from volume coefficients V_h 0.42 and V_v 0.035 at a 0.5 m arm (typical sport/trainer values), not measured outlines."
    },
    "massLedger": {
      "status": "estimated",
      "note": "Total 607 g from the cited listing. Motor, ESC, servos, receiver and battery masses are typical values for the listed parts; structure fills the remainder by fixed fractions. Battery station is solved for the CG."
    },
    "balance": {
      "status": "estimated",
      "note": "CG assumed at 27% of the mean chord; confirm against the kit's marked CG."
    },
    "aerodynamics": {
      "status": "estimated",
      "note": "Lift slope 2π/(1+2/(e·AR)), e 0.9, zero-lift -2°, stall 14°, CD0 0.026, CM -0.03. No measured polar or flight calibration."
    },
    "powertrain": {
      "status": "calculated",
      "note": "Bench curve from a first-order DC motor model (1180 KV, 0.15 Ω, 0.8 A no-load; estimated) driving a 9 × 4.7 with static C_T/C_P typical of UIUC propeller data, at 11.1 V nominal. Full command: 10.19 N, 19.0 A, 9738 rpm. Zero-thrust speed = pitch × full-command rpm. Not a thrust-stand measurement."
    },
    "operatingPoint": {
      "status": "estimated",
      "note": "Airborne trim 12 m/s chosen at about 1.5× the analytical stall estimate."
    },
    "thrustLine": {
      "status": "calculated",
      "note": "Thrust line at the CG height with 2.5° down-thrust, solved so full power leaves the pitching moment unchanged at the 12 m/s trim (the usual builder's power test). The kit's actual motor angle is not published here."
    }
  },

  "provenance": {
    "publishedDimensions": {
      "status": "sourced",
      "note": "1447 mm span, about 490 g assembled without battery, CG 57 mm from the wing leading edge, 12° control throws.",
      "url": "https://wiki.dallasmakerspace.org/wiki/FT_Explorer"
    },
    "powerPack": {
      "status": "sourced",
      "note": "Designed for Flite Test Power Pack B or C; this preset uses Power Pack B Radial v.2 (2212 1050 KV, 9×4.5).",
      "url": "https://flitetest.com/articles/ft-explorer-build"
    },
    "geometry": {
      "status": "estimated",
      "note": "Generated by scripts/generate-catalog-aircraft.ts from the sourced span, wing area and length. Rectangular-equivalent panels use the 0.2 m mean chord; fuselage sections, wing position, incidence 2° and dihedral are estimates, not traced plans."
    },
    "tail": {
      "status": "calculated",
      "note": "Tail areas from volume coefficients V_h 0.5 and V_v 0.035 at a 0.62 m arm (typical sport/trainer values), not measured outlines."
    },
    "massLedger": {
      "status": "estimated",
      "note": "Total 595 g from the cited listing. Motor, ESC, servos, receiver and battery masses are typical values for the listed parts; structure fills the remainder by fixed fractions. Battery station is solved for the CG."
    },
    "balance": {
      "status": "sourced",
      "note": "CG 57 mm behind the wing leading edge, as listed."
    },
    "aerodynamics": {
      "status": "estimated",
      "note": "Lift slope 2π/(1+2/(e·AR)), e 0.85, zero-lift -2.5°, stall 14°, CD0 0.028, CM -0.04. No measured polar or flight calibration."
    },
    "powertrain": {
      "status": "calculated",
      "note": "Bench curve from a first-order DC motor model (1050 KV, 0.25 Ω, 0.5 A no-load; estimated) driving a 9 × 4.5 with static C_T/C_P typical of UIUC propeller data, at 11.1 V nominal. Full command: 7.57 N, 12.3 A, 8415 rpm. Zero-thrust speed = pitch × full-command rpm. Not a thrust-stand measurement."
    },
    "operatingPoint": {
      "status": "estimated",
      "note": "Airborne trim 9 m/s chosen at about 1.5× the analytical stall estimate."
    },
    "thrustLine": {
      "status": "calculated",
      "note": "Thrust line at the CG height with 0° down-thrust, solved so full power leaves the pitching moment unchanged at the 9 m/s trim (the usual builder's power test). The kit's actual motor angle is not published here."
    }
  },

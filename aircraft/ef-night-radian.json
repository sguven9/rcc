  "provenance": {
    "publishedDimensions": {
      "status": "sourced",
      "note": "2000 mm span, 35.5 dm² wing area, 1140 mm length, 1200 g with a 3S 2200 mAh pack (1020 g without), per the BNF Basic manual summary.",
      "url": "https://www.notice-facile.com/en/manual/915081/e-flite+night-radian-2-0m-bnf-basic"
    },
    "equipment": {
      "status": "sourced",
      "note": "3533-960 KV 14-pole outrunner, 30 A ESC, two servos, folding 9.75×7.5 propeller.",
      "url": "https://www.skyraccoon.com/aircraft/E-flite_Night-Radian-20m_EFL36500"
    },
    "geometry": {
      "status": "estimated",
      "note": "Generated by scripts/generate-catalog-aircraft.ts from the sourced span, wing area and length. Rectangular-equivalent panels use the 0.177 m mean chord; fuselage sections, wing position, incidence 2.5° and dihedral are estimates, not traced plans."
    },
    "tail": {
      "status": "calculated",
      "note": "Tail areas from volume coefficients V_h 0.4 and V_v 0.025 at a 0.62 m arm (typical sport/trainer values), not measured outlines."
    },
    "massLedger": {
      "status": "estimated",
      "note": "Total 1200 g from the cited listing. Motor, ESC, servos, receiver and battery masses are typical values for the listed parts; structure fills the remainder by fixed fractions. Battery station is solved for the CG."
    },
    "balance": {
      "status": "estimated",
      "note": "CG assumed at 32% of the mean chord; confirm against the kit's marked CG."
    },
    "aerodynamics": {
      "status": "estimated",
      "note": "Lift slope 2π/(1+2/(e·AR)), e 0.9, zero-lift -3.5°, stall 13°, CD0 0.016, CM -0.06. No measured polar or flight calibration."
    },
    "powertrain": {
      "status": "calculated",
      "note": "Bench curve from a first-order DC motor model (960 KV, 0.08 Ω, 1 A no-load; estimated) driving a 9.75 × 7.5 folding with static C_T/C_P typical of UIUC propeller data, at 11.1 V nominal. Full command: 12.40 N, 23.3 A, 8869 rpm. Zero-thrust speed = pitch × full-command rpm. Not a thrust-stand measurement."
    },
    "operatingPoint": {
      "status": "estimated",
      "note": "Airborne trim 8 m/s chosen at about 1.5× the analytical stall estimate."
    },
    "thrustLine": {
      "status": "calculated",
      "note": "Thrust line at the CG height with 4.1° down-thrust, solved so full power leaves the pitching moment unchanged at the 8 m/s trim (the usual builder's power test). The kit's actual motor angle is not published here."
    }
  },

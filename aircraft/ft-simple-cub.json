  "provenance": {
    "publishedDimensions": {
      "status": "sourced",
      "note": "956 mm span and about 283 g (10 oz) assembled without battery for the original kit; 3S 1300 mAh pack recommended.",
      "url": "https://flitetest.com/simplecub"
    },
    "powerPack": {
      "status": "sourced",
      "note": "Flite Test Power Pack B Radial v.2: Radial 2212 1050 KV, 25 A ESC, 9×4.5 propellers.",
      "url": "https://www.getfpv.com/planes/flite-test-power-pack-b-radial-v-2.html"
    },
    "geometry": {
      "status": "estimated",
      "note": "Generated by scripts/generate-catalog-aircraft.ts from the sourced span, wing area and length. Rectangular-equivalent panels use the 0.19 m mean chord; fuselage sections, wing position, incidence 2° and dihedral are estimates, not traced plans."
    },
    "tail": {
      "status": "calculated",
      "note": "Tail areas from volume coefficients V_h 0.45 and V_v 0.04 at a 0.44 m arm (typical sport/trainer values), not measured outlines."
    },
    "massLedger": {
      "status": "estimated",
      "note": "Total 388 g from the cited listing. Motor, ESC, servos, receiver and battery masses are typical values for the listed parts; structure fills the remainder by fixed fractions. Battery station is solved for the CG."
    },
    "balance": {
      "status": "estimated",
      "note": "CG assumed at 27% of the mean chord; confirm against the kit's marked CG."
    },
    "aerodynamics": {
      "status": "estimated",
      "note": "Lift slope 2π/(1+2/(e·AR)), e 0.82, zero-lift -2.5°, stall 14°, CD0 0.03, CM -0.04. No measured polar or flight calibration."
    },
    "powertrain": {
      "status": "calculated",
      "note": "Bench curve from a first-order DC motor model (1050 KV, 0.25 Ω, 0.5 A no-load; estimated) driving a 9 × 4.5 with static C_T/C_P typical of UIUC propeller data, at 11.1 V nominal. Full command: 7.57 N, 12.3 A, 8415 rpm. Zero-thrust speed = pitch × full-command rpm. Not a thrust-stand measurement."
    },
    "operatingPoint": {
      "status": "estimated",
      "note": "Airborne trim 9 m/s chosen at about 1.5× the analytical stall estimate."
    },
    "thrustLine": {
      "status": "calculated",
      "note": "Thrust line at the CG height with 3.2° down-thrust, solved so full power leaves the pitching moment unchanged at the 9 m/s trim (the usual builder's power test). The kit's actual motor angle is not published here."
    }
  },

    },
    "geometry": {
      "status": "estimated",
      "note": "Generated by scripts/generate-catalog-aircraft.ts from the sourced span, wing area and length. Rectangular-equivalent panels use the 0.221 m mean chord; fuselage sections, wing position, incidence 2° and dihedral are estimates, not traced plans."
    },
    "tail": {
      "status": "calculated",
      "note": "Tail areas from volume coefficients V_h 0.5 and V_v 0.04 at a 0.62 m arm (typical sport/trainer values), not measured outlines."
    },
    "massLedger": {
      "status": "estimated",
      "note": "Total 1390 g from the cited listing. Motor, ESC, servos, receiver and battery masses are typical values for the listed parts; structure fills the remainder by fixed fractions. Battery station is solved for the CG."
    },
    "balance": {
      "status": "sourced",
      "note": "CG 79 mm behind the wing leading edge, as listed."
    },
    "aerodynamics": {
      "status": "estimated",
      "note": "Lift slope 2π/(1+2/(e·AR)), e 0.85, zero-lift -3°, stall 14°, CD0 0.025, CM -0.05. No measured polar or flight calibration."
    },
    "powertrain": {
      "status": "calculated",
      "note": "Bench curve from a first-order DC motor model (840 KV, 0.07 Ω, 1.2 A no-load; estimated) driving a 11 × 8 electric with static C_T/C_P typical of UIUC propeller data, at 11.1 V nominal. Full command: 15.04 N, 27.3 A, 7717 rpm. Zero-thrust speed = pitch × full-command rpm. Not a thrust-stand measurement."
    },
    "operatingPoint": {
      "status": "estimated",
      "note": "Airborne trim 11 m/s chosen at about 1.5× the analytical stall estimate."
    },
    "thrustLine": {
      "status": "calculated",
      "note": "Thrust line at the CG height with 0° down-thrust, solved so full power leaves the pitching moment unchanged at the 11 m/s trim (the usual builder's power test). The kit's actual motor angle is not published here."
    }
  },

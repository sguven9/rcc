  "provenance": {
    "publishedDimensions": {
      "status": "sourced",
      "note": "736 mm (29 in) span, about 170 g (6 oz) without battery; 2205 2300 KV, 6×4.5 prop, 12 A ESC minimum, 3S 850 mAh, two 5 g servos.",
      "url": "https://store.flitetest.com/ft-mighty-mini-arrow"
    },
    "geometry": {
      "status": "estimated",
      "note": "Generated by scripts/generate-catalog-aircraft.ts from the sourced span, wing area and length. Rectangular-equivalent panels use the 0.175 m mean chord; fuselage sections, wing position, incidence 1° and dihedral are estimates, not traced plans."
    },
    "tail": {
      "status": "estimated",
      "note": "Elevon and fin sizes estimated from typical flying-wing proportions; sweep is represented by the elevon moment arm."
    },
    "massLedger": {
      "status": "estimated",
      "note": "Total 245 g from the cited listing. Motor, ESC, servos, receiver and battery masses are typical values for the listed parts; structure fills the remainder by fixed fractions. Battery station is solved for the CG."
    },
    "balance": {
      "status": "estimated",
      "note": "CG assumed at 20% of the mean chord; confirm against the kit's marked CG."
    },
    "aerodynamics": {
      "status": "estimated",
      "note": "Lift slope 2π/(1+2/(e·AR)), e 0.8, zero-lift -0.5°, stall 13°, CD0 0.022, CM 0.005. No measured polar or flight calibration."
    },
    "powertrain": {
      "status": "calculated",
      "note": "Bench curve from a first-order DC motor model (2300 KV, 0.12 Ω, 0.8 A no-load; estimated) driving a 6 × 4.5 (pusher) with static C_T/C_P typical of UIUC propeller data, at 11.1 V nominal. Full command: 8.35 N, 22.7 A, 19267 rpm. Zero-thrust speed = pitch × full-command rpm. Not a thrust-stand measurement."
    },
    "operatingPoint": {
      "status": "estimated",
      "note": "Airborne trim 12 m/s chosen at about 1.5× the analytical stall estimate."
    },
    "thrustLine": {
      "status": "calculated",
      "note": "Thrust line at the CG height with 0° down-thrust, solved so full power leaves the pitching moment unchanged at the 12 m/s trim (the usual builder's power test). The kit's actual motor angle is not published here."
    }
  },
